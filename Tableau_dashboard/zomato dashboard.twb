      <column caption='Order Timestamp' datatype='date' name='[order_timestamp]' role='dimension' type='ordinal' />
      <column caption='Payment Mode' datatype='string' name='[payment_mode]' role='dimension' type='nominal' />
      <column caption='restaurant id (Restaurants)' datatype='string' name='[restaurant_id (Restaurants)]' role='dimension' type='nominal' />
      <column caption='Restaurant Id' datatype='string' name='[restaurant_id]' role='dimension' type='nominal' />
      <column caption='Restaurant Name' datatype='string' name='[restaurant_name]' role='dimension' type='nominal' />
      <column-instance column='[order_amount]' derivation='Attribute' name='[attr:order_amount:qk]' pivot='key' type='quantitative' />
      <column-instance column='[payment_mode]' derivation='Attribute' name='[attr:payment_mode:nk]' pivot='key' type='nominal' />
      <column-instance column='[order_amount]' derivation='Avg' name='[avg:order_amount:qk]' pivot='key' type='quantitative' />
      <column-instance column='[customer_id]' derivation='Count' name='[cnt:customer_id:qk]' pivot='key' type='quantitative' />
      <column-instance column='[order_id]' derivation='Count' name='[cnt:order_id:qk]' pivot='key' type='quantitative' />
      <column-instance column='[order_amount]' derivation='Median' name='[med:order_amount:qk]' pivot='key' type='quantitative' />
      <column-instance column='[order_timestamp]' derivation='Month' name='[mn:order_timestamp:ok]' pivot='key' type='ordinal' />
      <column-instance column='[Acquisition_channel]' derivation='None' name='[none:Acquisition_channel:nk]' pivot='key' type='nominal' />
      <column-instance column='[Customer_id]' derivation='None' name='[none:Customer_id:nk]' pivot='key' type='nominal' />
      <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
      <column-instance column='[cuisine]' derivation='None' name='[none:cuisine:nk]' pivot='key' type='nominal' />
      <column-instance column='[order_amount]' derivation='None' name='[none:order_amount:qk]' pivot='key' type='quantitative' />
      <column-instance column='[order_status]' derivation='None' name='[none:order_status:nk]' pivot='key' type='nominal' />
      <column-instance column='[payment_mode]' derivation='None' name='[none:payment_mode:nk]' pivot='key' type='nominal' />
      <column-instance column='[restaurant_name]' derivation='None' name='[none:restaurant_name:nk]' pivot='key' type='nominal' />
      <column-instance column='[order_amount]' derivation='Sum' name='[pcto:sum:order_amount:qk:2]' pivot='key' type='quantitative'>
        <table-calc ordering-type='Rows' type='PctTotal' />
      </column-instance>
      <column-instance column='[order_amount]' derivation='Sum' name='[pcto:sum:order_amount:qk]' pivot='key' type='quantitative'>
        <table-calc ordering-type='Columns' type='PctTotal' />
      </column-instance>
      <column-instance aggregation-param='5' column='[order_amount]' derivation='Percentile' name='[prc5:order_amount:qk]' pivot='key' type='quantitative' />
      <column-instance column='[order_amount]' derivation='Sum' name='[sum:order_amount:qk]' pivot='key' type='quantitative' />
      <column-instance column='[Calculation1]' derivation='User' name='[usr:Calculation1:qk]' pivot='key' type='quantitative'>
        <table-calc ordering-type='Rows' />
      </column-instance>
      <group caption='Action (Acquisition channel)' hidden='true' name='[Action (Acquisition channel)]' name-style='unqualified' user:auto-column='sheet_link'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[Acquisition_channel]' />
        </groupfilter>
      </group>
      <group caption='Action (City)' hidden='true' name='[Action (City)]' name-style='unqualified' user:auto-column='sheet_link'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[city]' />
        </groupfilter>
      </group>
      <group caption='Action (Cuisine,MONTH(Order Timestamp),Restaurant Name)' hidden='true' name='[Action (Cuisine,MONTH(Order Timestamp),Restaurant Name)]' name-style='unqualified' user:auto-column='sheet_link'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[cuisine]' />
          <groupfilter function='level-members' level='[mn:order_timestamp:ok]' />
          <groupfilter function='level-members' level='[restaurant_name]' />
        </groupfilter>
      </group>
      <group caption='Action (Customer id)' hidden='true' name='[Action (Customer id)]' name-style='unqualified' user:auto-column='sheet_link'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[Customer_id]' />
        </groupfilter>
      </group>
      <group caption='Action (Order Status)' hidden='true' name='[Action (Order Status)]' name-style='unqualified' user:auto-column='sheet_link'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[order_status]' />
        </groupfilter>
      </group>
      <group caption='Action (Payment Mode)' hidden='true' name='[Action (Payment Mode)]' name-style='unqualified' user:auto-column='sheet_link'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[payment_mode]' />
        </groupfilter>
      </group>
