      <aliases enabled='yes' />
      <column caption='Acquisition channel' datatype='string' name='[Acquisition_channel]' role='dimension' type='nominal' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_2988101495603201]) - LOOKUP(ZN([Calculation_2988101495603201]), -1)) / ABS(LOOKUP(ZN([Calculation_2988101495603201]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='percentage of orders by revenue' datatype='real' name='[Calculation_2049393144373249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_amount]) *100/COUNT([order_id])' />
      </column>
      <column caption='cancellation_rate' datatype='real' name='[Calculation_2988101495603201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE  [order_status] WHEN  &apos;cancelled&apos; THEN 1 ELSE 0 END)*100 /COUNT([order_id])' />
      </column>
      <column caption='refund_rate' datatype='real' name='[Calculation_2988101502984194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE [order_status] WHEN &apos;refunded&apos; then 1 else 0 END) * 100/ COUNT([order_id])' />
      </column>
      <column caption='order_status rate ' datatype='real' name='[Calculation_2988101503758339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([order_id]) / MAX({COUNT([order_id])}) * 100' />
      </column>
